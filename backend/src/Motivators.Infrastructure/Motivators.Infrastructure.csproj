<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Motivators.Application\Motivators.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Fluid.Core" Version="2.40.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
