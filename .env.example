# Переменные окружения для docker-compose.yml (в Coolify: Resource → Environment Variables).
# Здесь только секреты и то, что зависит от окружения. Остальное — в
# backend/src/Motivators.Api/appsettings.json (реквизиты, цены, адрес сайта, отправитель писем).

# PostgreSQL, формат Npgsql. Хост — внутренний uuid базы из Coolify, порт 5432.
DB_CONNECTION_STRING=Host=<uuid>;Port=5432;Database=motivators;Username=<user>;Password=<password>

# SMTP российского провайдера; порт 465 + SSL заданы в appsettings.json
SMTP_HOST=smtp.yandex.ru
SMTP_USERNAME=no-reply@movingmotivators.ru
SMTP_PASSWORD=<app-password>

# Доступ к /admin; несколько адресов — через запятую
ADMIN_EMAILS=owner@example.com
