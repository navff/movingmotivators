# Переменные окружения для docker-compose.yml (в Coolify: Resource → Environment Variables).
# Секретов в репозитории нет — этот файл только перечень.

# --- База данных (Coolify Database-ресурс PostgreSQL 17) ---
DB_CONNECTION_STRING=Host=<postgres-host>;Port=5432;Database=motivators;Username=<user>;Password=<password>

# --- Приложение ---
APP_BASE_URL=https://movingmotivators.ru
APP_PRODUCT_NAME=Движущие Мотиваторы: онлайн-тест
# несколько адресов — через запятую
APP_ADMIN_EMAILS=owner@example.com
APP_SHOW_ENGLISH_CARD_NAMES=false

# --- Цены (§7 SPEC) ---
PRICING_FREE_MAX_PARTICIPANTS=8
PRICING_SURVEY_PRICE_RUB=299
# fake — MVP, имитация оплаты; yookassa — фаза 1.5
PRICING_CHECKOUT_MODE=fake

# --- Почта (российский провайдер: Unisender Go, Яндекс 360 SMTP и т. п.) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# none | ssl | starttls | auto
SMTP_SECURITY=ssl
SMTP_USERNAME=no-reply@movingmotivators.ru
SMTP_PASSWORD=<app-password>
SMTP_FROM=no-reply@movingmotivators.ru
SMTP_FROM_NAME=Движущие Мотиваторы
SMTP_REPLY_TO=support@movingmotivators.ru

# --- Реквизиты исполнителя (футер, экран оплаты) ---
LEGAL_NAME=ИП Варнавский Владимир Николаевич
LEGAL_SHORT_NAME=ИП Варнавский В. Н.
LEGAL_INN=352826429326
LEGAL_OGRNIP=308352816800157
LEGAL_ADDRESS=162642, Вологодская обл., Череповецкий р-н, д. Шайма, ул. Вологодская, д. 11
LEGAL_EMAIL=support@movingmotivators.ru
